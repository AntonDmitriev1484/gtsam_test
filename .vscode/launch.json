{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run gtsam_test",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/out/build/linux-debug/gtsam_test",
      "args": ["opti_multi1_free_circle", "none", "live-slam-integration", "0.0", "true"],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}
